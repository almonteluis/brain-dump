<div class="pkp_block block_Keywordcloud">
	<span class="title">Keywords</span>
	<div class="content" id='wordcloud'></div>

	<script>
	function randomColor() {
		var cores = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd', '#8c564b', '#e377c2', '#7f7f7f', '#bcbd22', '#17becf'];
		return cores[Math.floor(Math.random()*cores.length)];
	}

	document.addEventListener("DOMContentLoaded", function() {
		var keywords = [{"text":"research paper","size":142},{"text":"learning analytics","size":121},{"text":"Learning analytics","size":32},{"text":"higher education","size":25},{"text":"ethics","size":15},{"text":"privacy","size":15},{"text":"collaborative learning","size":15},{"text":"editorial","size":14},{"text":"educational data mining","size":12},{"text":"multimodal learning analytics","size":12},{"text":"self-regulated learning","size":11},{"text":"machine learning","size":10},{"text":"MOOCs","size":10},{"text":"learning design","size":10},{"text":"Learning Analytics","size":9},{"text":"generative AI","size":9},{"text":"self regulated learning","size":8},{"text":"natural language processing","size":8},{"text":"collaboration","size":8},{"text":"social network analysis","size":8},{"text":"data and tools report","size":7},{"text":"online learning","size":7},{"text":"feedback","size":7},{"text":"equity","size":6},{"text":"assessment","size":6},{"text":"learning management system","size":6},{"text":"impact","size":6},{"text":"collaboration analytics","size":6},{"text":"transparency","size":6},{"text":"epistemic network analysis","size":6},{"text":"Learning design","size":6},{"text":"CSCL","size":6},{"text":"motivation","size":5},{"text":"dashboard","size":5},{"text":"game-based learning","size":5},{"text":"trust","size":5},{"text":"systematic review","size":5},{"text":"curriculum analytics","size":5},{"text":"artificial intelligence","size":5},{"text":"creativity","size":5},{"text":"data protection","size":5},{"text":"network analysis","size":4},{"text":"generative artificial intelligence","size":4},{"text":"orchestration","size":4},{"text":"MOOC","size":4},{"text":"computational thinking","size":4},{"text":"predictive analytics","size":4},{"text":"research","size":4},{"text":"practice","size":4},{"text":"learning","size":4}];
		var totalWeight = 0;
		var width = 300;
		var height = 200;
		var transitionDuration = 200;	
		var length_keywords = keywords.length;
		var layout = d3.layout.cloud();

		layout.size([width, height])
			.words(keywords)
			.fontSize(function(d)
			{
				return fontSize(+d.size);
			})
			.on('end', draw);
		
		var svg = d3.select("#wordcloud").append("svg")
			.attr("viewBox", "0 0 " + width + " " + height)	
			.attr("width", '100%');		
		
		function update() {
			var words = layout.words();
			fontSize = d3.scaleLinear().range([16, 34]);
			if (words.length) {
				fontSize.domain([+words[words.length - 1].size || 1, +words[0].size]);
			}
		}
		
		keywords.forEach(function(item,index){totalWeight += item.size;});

		update();

		function draw(words, bounds) {
			var w = layout.size()[0],
                h = layout.size()[1];

			scaling = bounds
                ? Math.min(
                      w / Math.abs(bounds[1].x - w / 2),
                      w / Math.abs(bounds[0].x - w / 2),
                      h / Math.abs(bounds[1].y - h / 2),
                      h / Math.abs(bounds[0].y - h / 2),
                  ) / 2
                : 1;

			svg
			.append("g")
			.attr(
                "transform",
                "translate(" + [w >> 1, h >> 1] + ")scale(" + scaling + ")",
            )
			.selectAll("text")
				.data(words)
			.enter().append("text")
				.style("font-size", function(d) { return d.size + "px"; })
				.style("font-family", 'serif')
				.style("fill", randomColor)
				.style('cursor', 'pointer')
				.style('opacity', 0.7)
				.attr('class', 'keyword')
				.attr("text-anchor", "middle")
				.attr("transform", function(d) {
					return "translate(" + [d.x, d.y] + ")rotate(" + d.rotate + ")";
				}) 
				.text(function(d) { return d.text; })
				.on("click", function(d, i){
					window.location = "https://learning-analytics.info/index.php/JLA/search?query=QUERY_SLUG".replace(/QUERY_SLUG/, encodeURIComponent(''+d.text+''));
				})
				.on("mouseover", function(d, i) {
					d3.select(this).transition()
						.duration(transitionDuration)
						.style('font-size',function(d) { return (d.size + 3) + "px"; })
						.style('opacity', 1);
				})
				.on("mouseout", function(d, i) {
					d3.select(this).transition()
						.duration(transitionDuration)
						.style('font-size',function(d) { return d.size + "px"; })
						.style('opacity', 0.7);
				})
				.on('resize', function() { update() });
		}

		layout.start();

	});

	</script>
</div>
